<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/clarity_surface">

    <LinearLayout
        android:id="@+id/candidate_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp"
        android:background="@color/clarity_bg">

        <HorizontalScrollView
            android:id="@+id/candidate_status_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/candidate_strip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/candidate_pager_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        android:background="@color/clarity_bg">

        <TextView
            android:id="@+id/candidate_raw_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:textColor="@color/clarity_text_secondary"
            android:textSize="12sp" />

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/candidate_pager"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="左右滑动切换候选"
                android:textColor="@color/clarity_text_muted"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btn_none_fit"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="都不对…"
                android:textAllCaps="false"
                android:textColor="@color/clarity_danger"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/clarity_divider" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="@color/clarity_surface">

        <Button
            android:id="@+id/btn_mic"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="语音清晰化"
            android:textAllCaps="false"
            android:textColor="@color/clarity_surface"
            android:backgroundTint="@color/clarity_accent" />
        <Button
            android:id="@+id/btn_mode"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="通用"
            android:textAllCaps="false"
            android:textColor="@color/clarity_accent"
            android:backgroundTint="@color/clarity_accent_light" />
        <Button
            android:id="@+id/btn_settings"
            android:layout_width="48dp"
            android:layout_height="40dp"
            android:text="设置"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:textColor="@color/clarity_text_secondary"
            android:backgroundTint="@color/clarity_bg" />
    </LinearLayout>

    <android.inputmethodservice.KeyboardView
        android:id="@+id/keyboard_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:keyBackground="@android:drawable/btn_default"
        android:keyTextSize="18sp"
        android:background="@color/clarity_bg" />
</LinearLayout>
